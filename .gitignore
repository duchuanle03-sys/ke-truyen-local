# Track only source, docs and regression tests.
# Personal libraries, the built app, logs, local notes and analysis stay local.
*
!.gitignore
!README.md
!CLAUDE.md
!/docs/
!/docs/architecture.md
!/web/
!/web/app.js
!/web/captcha.js
!/web/index.html
!/web/reader.js
!/web/style.css
!/windows/
!/windows/pdfocr.ps1
!/windows/shortcut.ps1
!/rust/
!/rust/Cargo.toml
!/rust/Cargo.lock
!/rust/src/
!/rust/src/*.rs
!/rust/src/stv/
!/rust/src/stv/*.rs
!/rust/tests/
!/rust/tests/*.rs
!/rust/tests/fixtures/
!/rust/tests/fixtures/python_reference.json
!/rust/tests/fixtures/*/
!/rust/tests/fixtures/*/library.sqlite3
!/rust/tests/fixtures/*/m1-fixture.json
